{
  "profiles": {
    "cloudflare.default": {
      "provider": "cloudflare",
      "path": "~/.agents/local/credentials/cloudflare.env"
    },
    "parallel.api": {
      "provider": "parallel",
      "path": "~/.secrets.sh",
      "variables": [
        "PARALLEL_API_KEY"
      ]
    },
    "railway.workspace": {
      "provider": "railway",
      "path": "~/.secrets.sh",
      "variables": [
        "RAILWAY_API_TOKEN"
      ]
    },
    "twilio.sms": {
      "provider": "twilio",
      "path": "~/.agents/local/credentials/twilio-sms.env"
    }
  }
}
